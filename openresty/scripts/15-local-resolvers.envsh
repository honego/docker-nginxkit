# Based on the NGINX Docker entrypoint script, modified for OpenResty.

set -eu

LC_ALL=C
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

[ "${RESTY_ENTRYPOINT_LOCAL_RESOLVERS:-}" ] || return 0

RESTY_LOCAL_RESOLVERS="$(awk 'BEGIN{ORS=" "} $1=="nameserver" {if ($2 ~ ":") {print "["$2"]"} else {print $2}}' /etc/resolv.conf)"

RESTY_LOCAL_RESOLVERS="${RESTY_LOCAL_RESOLVERS% }"

export RESTY_LOCAL_RESOLVERS
